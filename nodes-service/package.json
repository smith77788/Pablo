{
  "name": "infragram-nodes-service",
  "version": "1.0.0",
  "description": "Telegram Nodes — управление мегагруппами-форумами (Node) и топиками (SubNode) через MTProto (gramjs).",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "big-integer": "^1.6.52",
    "express": "^4.19.2",
    "telegram": "^2.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "prisma": "^5.18.0",
    "typescript": "^5.5.4"
  }
}
