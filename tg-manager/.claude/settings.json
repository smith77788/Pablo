{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.githooks/run-workspace-guard.sh\" --worktree \"${CLAUDE_PROJECT_DIR}\" --claude-session",
            "timeout": 45
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.githooks/run-workspace-guard.sh\" --worktree \"${CLAUDE_PROJECT_DIR}\" --claude-pretool",
            "timeout": 10
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.githooks/run-workspace-guard.sh\" --claude-worktree-create",
            "timeout": 60
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.githooks/run-workspace-guard.sh\" --claude-worktree-remove",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
