# Контекст сборки Docker. Без него `COPY . .` тащил в образ весь репозиторий
# (~70 МБ: .git, tests/ на 36 МБ, кэши) — лишние память и время на сборку, что
# повышало риск упасть на сборочной инфраструктуре Railway (Infrastructure
# Error на шаге Build image). Исключаем ТОЛЬКО то, что приложению в рантайме не
# нужно: VCS, тесты, кэши, артефакты. Схему (schema*.sql), код, mini_app/ и
# requirements.txt НЕ исключаем — они нужны рабочему контейнеру.
.git
.github
.gitignore

# Тесты не исполняются в проде (прод-код на них не ссылается — проверено).
tests/

# Python-кэши и артефакты сборки.
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Node (если затесался) и логи.
node_modules/
*.log

# Локальные окружения — секреты и мусор не должны попадать в образ.
.env
.env.*
venv/
.venv/
