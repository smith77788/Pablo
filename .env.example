# Переменные окружения контейнера Infragram.
#
# В образе едут два процесса (см. start-all.sh):
#   - tg-manager  — сам продукт, основной процесс;
#   - assistant   — личный бот владельца, фоновый, в своём venv.
#
# Полный список переменных tg-manager (база, токен, лимиты, AI-провайдеры,
# роли реплик) — в tg-manager/.env.example. Здесь только то, что задаётся
# на уровне контейнера.

# ── tg-manager: минимум для запуска ───────────────────────────────────────
MANAGER_BOT_TOKEN=replace-with-manager-bot-token
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Роль реплики: all | web | worker.
# Без OP_SHARDED_EXECUTOR очередь операций разбирает ОДИН процесс (держатель
# аренды исполнителя), лишние worker'ы ждут (services/replica_guard.py).
INFRAGRAM_ROLE=all

# Горизонтальный исполнитель: операции разбирают ВСЕ процессы с ролью
# worker/all, каждый до OP_MAX_PARALLEL; сторожа очереди и фоновые циклы —
# только у лидера. Ёмкость растёт числом реплик worker. Включать на всех
# репликах сразу. Подробности — services/op_worker.py, «Горизонтальный
# исполнитель».
# OP_SHARDED_EXECUTOR=1
# OP_MAX_PARALLEL=8
# Пул соединений БД на процесс (каждой реплике — свой; сумма по репликам должна
# помещаться в max_connections базы).
# DB_POOL_MAX=20

# ── assistant: личный бот ─────────────────────────────────────────────────
# Свой токен, чтобы не конфликтовать с MANAGER_BOT_TOKEN.
ASSISTANT_BOT_TOKEN=
# Telegram user_id владельцев через запятую — кому бот вообще отвечает.
ASSISTANT_ADMIN_IDS=
# Куда класть историю диалогов (переживает рестарт контейнера).
ASSISTANT_STATE_DIR=data/assistant

# ── AI-провайдер (общий для tg-manager и assistant) ───────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-4-6
